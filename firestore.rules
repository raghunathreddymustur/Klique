rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Lock down everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure Rules for Klique Wishlists
    // Path: artifacts/{appId}/wishlists/{wishlistId}
    match /artifacts/{appId}/wishlists/{wishlistId} {
      
      // ALLOW CREATE IF:
      // 1. User is signed in (request.auth != null)
      // 2. User claims the record as their own (uid matches)
      // 3. Basic data validation (email and goal are strings)
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.goal is string;

      // ALLOW READ IF:
      // 1. User created the record (uid matches)
      // OR
      // 2. User's email matches the record (if they sign in with that email later)
      allow read: if request.auth != null 
                  && (request.auth.uid == resource.data.uid || resource.data.email == request.auth.token.email);
                  
      // No updates or deletes allowed for now (Immutable history)
      allow update, delete: if false; 
    }
  }
}
